{
  "name": "proto-ikon-loader-wc",
  "version": "0.1.260",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/proto-ikon-loader-wc/proto-ikon-loader-wc.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "release": "pnpm bump && pnpm build",
    "preinstall": "npx only-allow pnpm",
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "echo --skip",
    "generate": "stencil generate",
    "prebuild": "pnpm format",
    "spell": "cspell 'src/**/*.{ts,tsx,html,css,md}' ",
    "cc": "prettier --check src cSpell.json",
    "format": "prettier --write src cSpell.json",
    "lint": "eslint src/**/*.{ts,tsx}"
  },
  "dependencies": {
    "@stencil/core": "4.44.2",
    "proto-ikons-wc": "0.1.97"
  },
  "devDependencies": {
    "bumpp": "12.2.2",
    "cspell": "10.1.1",
    "eslint": "10.9.1",
    "only-allow": "1.2.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "yoctocolors": "2.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eswat2/proto-ikon-loader.git"
  },
  "bugs": {
    "url": "https://github.com/eswat2/proto-ikon-loader/issues"
  },
  "homepage": "https://github.com/eswat2/proto-ikon-loader#readme",
